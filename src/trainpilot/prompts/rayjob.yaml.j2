# spec_hash: {{ spec_hash }} attempt: {{ attempt }} spec_version: {{ spec_version }}
# Generated by TrainPilot-Local from TrainingSpec; never patch by hand.
apiVersion: ray.io/v1
kind: RayJob
metadata:
  name: {{ job_name }}
  namespace: trainpilot-jobs
  labels:
    app: trainpilot-local
    spec-hash: "{{ spec_hash }}"
spec:
  entrypoint: "python training/train.py --config train_config.yaml"
  runtimeEnvYaml: |
    pip: []
    env_vars:
      TRAINPILOT_BACKEND: "{{ spec.backend }}"
  shutdownAfterJobFinishes: true
  rayClusterSpec:
    rayVersion: "2.41.0"
    headGroupSpec:
      rayStartParams:
        dashboard-host: "0.0.0.0"
      template:
        spec:
          containers:
            - name: ray-head
              image: "rayproject/ray:2.41.0"
              resources:
                limits:
                  memory: "2Gi"
    workerGroupSpecs:
      - groupName: workers
        replicas: {{ spec.num_workers }}
        minReplicas: {{ spec.num_workers }}
        maxReplicas: {{ spec.num_workers }}
        rayStartParams: {}
        template:
          spec:
            containers:
              - name: ray-worker
                image: "rayproject/ray:2.41.0"
                resources:
                  limits:
                    memory: "{{ spec.resources_per_worker_memory }}"
                  requests:
                    memory: "{{ spec.resources_per_worker_memory }}"
