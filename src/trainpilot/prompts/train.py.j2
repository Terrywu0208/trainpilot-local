# spec_hash: {{ spec_hash }} attempt: {{ attempt }} spec_version: {{ spec_version }}
"""Training entrypoint generated by TrainPilot-Local from TrainingSpec.

This file is regenerated from the spec on every attempt; never patch it
by hand. It follows the section C result contract: TRAINPILOT_STEP lines
while training and one TRAINPILOT_RESULT JSON line at the end.
"""
import argparse
import json

CONFIG = {
    "model_name": "{{ spec.model_name }}",
    "model_revision": "{{ spec.model_revision }}",
    "dataset": "{{ spec.dataset }}",
    "backend": "{{ spec.backend }}",
    "per_worker_batch_size": {{ spec.per_worker_batch_size }},
    "gradient_accumulation_steps": {{ spec.gradient_accumulation_steps }},
    "num_workers": {{ spec.num_workers }},
    "resources_per_worker_memory": "{{ spec.resources_per_worker_memory }}",
    "epochs": {{ spec.epochs }},
    "max_steps": {{ spec.max_steps }},
    "learning_rate": {{ spec.learning_rate }},
    "train_subsample": {{ spec.train_subsample }},
    "val_subsample": {{ spec.val_subsample }},
    "max_length": {{ spec.max_length }},
    "seed": {{ spec.seed }},
}


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", default="train_config.yaml")
    args = parser.parse_args()
    print("trainpilot: starting with config " + args.config)
    for step in range(1, CONFIG["max_steps"] + 1):
        print("TRAINPILOT_STEP " + json.dumps({"step": step}))
    result = {
        "status": "ok",
        "backend": CONFIG["backend"],
        "effective_batch": (
            CONFIG["per_worker_batch_size"]
            * CONFIG["gradient_accumulation_steps"]
            * CONFIG["num_workers"]
        ),
    }
    print("TRAINPILOT_RESULT " + json.dumps(result))


if __name__ == "__main__":
    main()
